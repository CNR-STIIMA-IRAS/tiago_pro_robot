<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find tiago_v2_prototype_description)/urdf/deg_to_rad.xacro" />
  <xacro:macro name="tiago_v2_prototype_end_effector" params="name parent type">

  <!-- Robotiq 2F-85 Gripper -->
    <xacro:if value="${type == 'robotiq-2f-85'}">
      <xacro:include filename="$(find pal_robotiq_85_description)/urdf/robotiq_85_gripper.urdf.xacro" />
      <xacro:robotiq_85_gripper prefix="${name}_" parent="${parent}" >
        <origin xyz="0 0 0" rpy="${0*deg_to_rad} ${180*deg_to_rad} ${0*deg_to_rad}"/>
      </xacro:robotiq_85_gripper>
    </xacro:if>
  
  </xacro:macro>

</robot>
