<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <!--arg name="laser_model"  default="sick-571"/-->
    <arg name="end_effector"  default="robotiq-2f-85"/>

    <!-- Joint state controllers -->
    <include file="$(find tiago_v2_prototype_controller_configuration)/launch/joint_state_controller.launch"/>
    <!-- Default controllers -->
    <include file="$(find tiago_v2_prototype_controller_configuration)/launch/default_controllers.launch"/>

    <group if="$(eval end_effector == 'robotiq-2f-85')">
        <rosparam command="load" file="$(find tiago_controller_configuration)/config/robotiq-2f-85_joint_trajectory_controllers.yaml" />
        <include file="$(find pal_robotiq_controller_configuration)/launch/gripper_controller.launch">
          <arg name="model" value="$(arg end_effector)" />
        </include>
    </group>

</launch>

