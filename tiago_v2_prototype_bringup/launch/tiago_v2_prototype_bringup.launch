<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="robot_namespace" default=""/>

  <rosparam command="load" file="$(find tiago_v2_prototype_bringup)/config/tiago2_pids.yaml" ns="actuator_pid_command_controller"/>

  <node name="actuator_pid_command_controller_spawner" pkg="controller_manager" type="spawner" output="screen" 
        args="--timeout 300 actuator_pid_command_controller" />

  <!-- Load default controllers -->
  <include file="$(find tiago_v2_prototype_controller_configuration)/launch/tiago_v2_prototype_controllers.launch"/>

  <!-- Robot state publisher -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
    <param name="publish_frequency" type="double" value="50.0"/>
    <param name="tf_prefix" type="string" value="$(arg robot_namespace)"/>
    <param name="use_tf_static" type="bool" value="true"/>
  </node>

  <!-- Robot pose publisher -->
  <!-- <node pkg="robot_pose" type="robot_pose_node" name="robot_pose_publisher" output="screen"/> -->

  <!-- TF lookup -->
  <node pkg="tf_lookup" type="tf_lookup" name="tf_lookup" output="screen"/>

  <!-- Twist mux -->
  <include file="$(find tiago_v2_prototype_bringup)/launch/twist_mux.launch"/>

  <!-- Joystick controller -->
  <include file="$(find tiago_v2_prototype_bringup)/launch/joystick_teleop.launch"/>

  <!-- Motion planning -->
  <include file="$(find tiago_v2_prototype_moveit_config)/launch/move_group.launch"/>

  <!-- Launch play motion -->
  <include file="$(find tiago_v2_prototype_bringup)/launch/play_motion.launch"/>
</launch>
